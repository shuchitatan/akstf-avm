# =====================================================
# AKS Module Configuration - Development
# =====================================================
# Copy this file to aks.tfvars and update values:
#   cp aks.tfvars.example aks.tfvars
#
# Get backend_storage_account_name from bootstrap output:
#   cd ../0-bootstrap && terraform output storage_account_name
# =====================================================

# Azure Subscription ID (required)
subscription_id = "<YOUR_SUBSCRIPTION_ID>"

# Core Configuration
environment                  = "dev"
backend_storage_account_name = "<YOUR_STORAGE_ACCOUNT_FROM_BOOTSTRAP>"

# AKS Cluster
name                = "aks01-baseline-dev"
location            = "australiaeast"
resource_group_name = "rg-aks01-baseline-dev"

# Kubernetes Configuration
kubernetes_version = "1.31"
network_policy     = "cilium"

# Network Configuration (CNI Overlay)
pod_cidr                = "10.244.0.0/16"
service_cidr            = "10.245.0.0/16"
dns_service_ip          = "10.245.0.10"
private_cluster_enabled = true

# Default Node Pool
vm_size = "Standard_D4d_v5"

# Additional User Node Pools (optional)
# node_pools = {
#   user = {
#     name                 = "apps"
#     orchestrator_version = "1.31"
#     vm_size              = "Standard_D4d_v5"
#     min_count            = 1
#     max_count            = 3
#   }
# }

# Container Registry
enable_acr = true
acr_name   = "<YOUR_UNIQUE_ACR_NAME>"

# Kubernetes Namespaces (to be created post-deployment)
namespaces = [
  {
    name = "development"
    labels = {
      environment = "dev"
      team        = "platform"
    }
  },
  {
    name = "staging"
    labels = {
      environment = "staging"
      team        = "platform"
    }
  }
]

# Tags
tags = {
  Environment = "dev"
  ManagedBy   = "Terraform"
  Project     = "AKS"
}

enable_telemetry = true
